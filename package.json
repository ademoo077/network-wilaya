{
  "name": "wilaya-anomalies",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Plateforme de suivi des anomalies (points noirs) - Wilaya d'Alger",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/src/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node scripts/start.js",
    "test": "vitest run && node scripts/check-styles.js",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/e2e.js",
    "lint": "eslint .",
    "check:styles": "node scripts/check-styles.js",
    "check:a11y": "node scripts/check-a11y.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:purge": "node scripts/seed-demo-purge.js",
    "admin:reset": "node scripts/admin-reset.js",
    "backup": "node scripts/backup.js",
    "db:check": "node scripts/db-check.js",
    "https:setup": "node scripts/https-setup.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.38",
    "selfsigned": "^5.5.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
